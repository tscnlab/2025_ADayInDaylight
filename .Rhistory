#this is a high level summary for generating a length-weighted list of options people chose.
high_level_list <-
events_complete |>
pivot_longer(
-c(Datetime:record_id, notes:city),
values_transform = as.character)
duration_complete <-
events_complete |>
summarize(duration = sum(status.duration, na.rm = TRUE)) |>
pull(duration)
duration_complete_formatted <-
duration_complete |> vec_fmt_duration(input_units = "secs", output_units = "hours")
names_events <-
events_complete |>
select(-c(Datetime:record_id, notes:city)) |>
map(\(x) attr(x, "label")) |> list_simplify()
# high_level_list <-
high_level_list |>
mutate(name = names_events[name]) |>
count(name, value,
sort = TRUE, wt = status.duration) |>
drop_na(value) |>
group_by(name) |>
gt() |>
fmt_duration(n, input_units = "secs", output_units = "hours") |>
cols_add(relative.duration =
(n |> as.numeric()) / (duration_complete |> as.numeric())
) |>
tab_style_body(targets = "row",
columns = relative.duration,
fn  = \(x) x < 0.05,
style = cell_text(color = "blue")) |>
tab_style_body(targets = "row",
columns = relative.duration,
fn  = \(x) x < 0.01,
style = cell_text(color = "red")) |>
fmt_percent(relative.duration, decimals = 1) |>
cols_label(value = "Participant activities and contexts",
n = "Represented duration",
relative.duration = "Relative duration") |>
tab_footnote(
glue(
"Based on a total represented duration of {duration_complete_formatted}."
),locations = cells_column_labels(relative.duration)
) |>
tab_header(md("**A DAY IN DAYLIGHT** event: participant activities and contexts, weighted by their absolute and relative duration in the collected data"), subtitle = md("Activities and contexts with <span style='color: blue;'>less than five percent</span> of represented time are colored <span style='color: blue;'>blue</span>, and with <span style='color: red;'>less than one percent</span> of represented time are colored <span style='color: red;'>red</span>")) |>
gtsave("tables/ADayInDaylight_inventory.docx")
